descripciones_transporte = [gasto["descripcion"] for gasto in gasto_semana if gasto["categoria"] == "transporte"]
diccionario_gastos = {gasto["descripcion"]: gasto["monto"] for gasto in gasto_semana}
print("Montos con IVA (15%):", montos_con_iva)
print("Descripciones de Transporte:", descripciones_transporte)
print("Diccionario de Gastos:", diccionario_gastos)
print("Encontrado el primer gasto mayor a 50 ")
for gasto in gasto_semana:
    if gasto["monto"] > 50:
        print(f"Ciclo interrumpido en: {gasto['descripcion']} (${gasto['monto']})")
        break
suma_filtrada = 0
for gasto in gasto_semana:
    if gasto["categoria"] == "otros":
        continue
    suma_filtrada += gasto["monto"]
print(f"\nSuma total (excluyendo la categoría 'otros'): ${suma_filtrada:.2f}")
import random
secreto = random.randint(1, 50)
intentos_restantes = 6
print("¡Adivina el Número!")
print("Tienes 6 intentos para descubrir un número entero que va entre el 1 y el 50.")

while intentos_restantes > 0:
    try:
        posible_numero = int(input(f"\nTe quedan {intentos_restantes} intentos. Ingresa tu número: "))
        if posible_numero == secreto:
            print(f"¡Felicidades! Adivinaste el número secreto ({secreto}).")
            break
        elif posible_numero < secreto:
            print("El número secreto es mayor.")
        else:
            print("El número secreto es menor.")
        intentos_restantes -= 1
    except ValueError:
        print("Por favor, introduce solo un número entero válido.")
        continue

if intentos_restantes == 0:
    print(f"\nTe has quedado sin intentos. El número secreto era {secreto}. ¡Suerte la próxima!")