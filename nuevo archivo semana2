print(f"Se han registrado con éxito {len(gasto_semana)} gastos.")
print("____________________________________________")
# Prueba con montos diferentes
montos_prueba = [4.99, 5, 50, 50.01]
for monto in montos_prueba:
    if monto < 5:
        resultado = "gasto menor"
    elif monto <= 50:
        resultado = "gasto medio"
    else:
        resultado = "gasto mayor"

    print(f"Monto: {monto} -> {resultado}")
    total_gastos = 0
contador_mayores = 0
monto_mas_alto = 0.0
for gasto in gasto_semana:
    monto = gasto["monto"]
    total_gastos += monto
    if monto > 50:
        contador_mayores += 1
    if monto > monto_mas_alto:
        monto_mas_alto = monto

print(f"Total gastado: ${total_gastos:.2f}")
print(f"Cantidad de 'gastos mayores' (>50): {contador_mayores}")
print(f"Monto más alto encontrado: ${monto_mas_alto:.2f}")
for indice, gasto in enumerate(gasto_semana, start=1):
    print(f"{indice}. {gasto['fecha']} – {gasto['categoria']} – {gasto['monto']:.2f}")
ahorro_actual = 0
semanas_necesitadas = 0
while ahorro_actual < 200:
    ahorro_actual += 15
    semanas_necesitadas += 1

print(f"Se necesitaron {semanas_necesitadas} semanas para alcanzar ${ahorro_actual}.")
